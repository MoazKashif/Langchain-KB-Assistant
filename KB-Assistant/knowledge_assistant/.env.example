# Copy this file to .env and fill in your real values.
# Never commit your real .env file.

# --- Model provider (groq | openai | anthropic | ollama) ---
MODEL_PROVIDER=groq
# Good Groq models: llama-3.3-70b-versatile, llama-3.1-8b-instant,
# llama-3.1-70b-versatile, qwen-2.5-32b, mixtral-8x7b-32768
MODEL_NAME=llama-3.3-70b-versatile

# --- API keys (one of these, matching MODEL_PROVIDER) ---
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Ollama (optional, for fully-local runs) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Retrieval ---
RETRIEVER_TOP_K=4
RETRIEVAL_MIN_SCORE=2.0

# --- LangSmith tracing (optional; only enabled when credentials present) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=kb-assistant

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/assistant.log
